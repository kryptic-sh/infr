#version 460
// Causal depthwise conv, BATCH pass 2 of 2: rebuild the per-channel history from the LAST K-1
// input rows. Requires rows ≥ K-1 (guaranteed by the host-side routing), so the new state reads
// only `qkv` — never the state buffer it overwrites (no intra-dispatch hazard).
//   state[k][ch] = qkv[rows-(K-1)+k][ch]
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC { uint rows; uint cc; uint kconv; } pc;

layout(binding = 0) readonly buffer XB { float qkv[]; };    // [rows, cc]
layout(binding = 1) buffer SB { float cstate[]; };          // [(kconv-1)*cc] out

// -DSHORTCONV: binding 0 is LFM's `[rows, 3*cc]` B | C | X rows, and the history holds B ⊙ X — the
// conv's input, as in conv1d_silu.comp's SHORTCONV build.
#ifdef SHORTCONV
#define CONV_IN(t, ch) (qkv[(t) * 3u * pc.cc + (ch)] * qkv[(t) * 3u * pc.cc + 2u * pc.cc + (ch)])
#else
#define CONV_IN(t, ch) qkv[(t) * pc.cc + (ch)]
#endif

void main() {
    // Flat index across `Recorder::dispatch_wide`'s 2-D split of a grid wider than
    // `maxComputeWorkGroupCount[0]`; equal to `gl_GlobalInvocationID.x` when unsplit.
    uint idx = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * gl_WorkGroupSize.x
        + gl_LocalInvocationID.x;
    uint km1 = pc.kconv - 1u;
    if (idx >= km1 * pc.cc) {
        return;
    }
    uint k = idx / pc.cc;
    uint ch = idx % pc.cc;
    cstate[idx] = CONV_IN(pc.rows - km1 + k, ch);
}
