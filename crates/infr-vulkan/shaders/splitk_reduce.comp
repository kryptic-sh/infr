#version 460
// Split-K reduce: out[i] = Σ_s part[s·plane + i] over `splits` planes — the deterministic
// (fixed-order) sum that closes a split-K GEMM. One thread per output element.
// -DKAHAN (the `splitk_reduce_kahan` build) compensates the sum: a plain f32 sum of the planes
// rounds against the running total at every step, and that rounding is what the fp32 K-quant
// tile's own compensation removed inside each slice (measurements: docs/gpu-tolerance.md,
// "The fp32 K-quant prefill GEMM in the float runs"). A sum that reaches
// +-inf comes out NaN from this build (inf - inf in the compensation) where the plain build
// writes inf. The plain build is unchanged.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC { uint n_elems; uint splits; uint plane; } pc;
layout(binding = 0) readonly buffer PB { float part[]; };
layout(binding = 1) writeonly buffer OB { float o[]; };

void main() {
    // Flat index across `Recorder::dispatch_wide`'s 2-D split of a grid wider than
    // `maxComputeWorkGroupCount[0]`; equal to `gl_GlobalInvocationID.x` when unsplit.
    uint i = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * gl_WorkGroupSize.x
        + gl_LocalInvocationID.x;
    if (i >= pc.n_elems) { return; }
#ifdef KAHAN
    // `precise` keeps the compiler from folding the compensation `(t - acc) - y` to zero.
    precise float acc = 0.0;
    precise float c = 0.0;
    for (uint s = 0u; s < pc.splits; s++) {
        precise float y = part[s * pc.plane + i] - c;
        precise float t = acc + y;
        c = (t - acc) - y;
        acc = t;
    }
#else
    float acc = 0.0;
    for (uint s = 0u; s < pc.splits; s++) { acc += part[s * pc.plane + i]; }
#endif
    o[i] = acc;
}
