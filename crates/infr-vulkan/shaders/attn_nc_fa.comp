#version 460
// Non-coopmat shared-memory fma flash-attention for PREFILL (the "nc_fa" tier, adapter.rs
// `nc_fa_ok`): fused tile QK^T → online softmax → PV accumulate, NO materialized [m,kv] scores.
// This is the attention companion of native_gemm_fma.comp — R1 un-gated the prefill GEMMs for
// devices without a usable 16x16x16 f16 coopmat (Intel Arc/ANV), which left the scalar per-row
// `attention_kv` as their ONLY full-tile prefill attention (31% of knob pp512 on Qwen3-14B, worse
// at depth). Every flash/nonfa prefill kernel here is coopmat SPIR-V, so before this kernel a
// non-coopmat device ran ALL prefill attention rows one at a time.
//
// Design constraints (Intel Arc audit):
//  • NO subgroup ops anywhere — reductions go through shared memory, and no layout depends on
//    gl_SubgroupSize (Arc enumerates 8-32; ANV may pick any).
//  • SMALL row tile: BM=32 (16 for the hd=512 build) × BN=64 kv block, 256 threads.
//  • Shared within the 32 KB every Vulkan device guarantees (`maxComputeSharedMemorySize`): Q is
//    staged in KC-dim chunks next to the matching K chunk, V in VC-dim chunks into the same
//    buffer, and the output accumulator lives in registers.
//  • Barriers AFTER all shared reads of an iteration (the mmq race lesson) — a fast thread must
//    never restage Qs/KVs/Ss while a slow one still reads the previous block's values.
//
// Register blocking, which is what makes the tier fast on a small GPU: shared-memory reads, not
// arithmetic, bound the earlier one-score-column-per-load form. Each thread computes RS query
// rows × 2 key columns of the score tile from vec4 reads (RS + 2 reads per 4·2·RS fmas), and
// RO rows × 4 dims of the output per V chunk (RO + 4 reads per 16·RO fmas per 4 keys). The
// softmax runs SM_T threads per row with the row max and sum combined through shared memory.
// Every score and output sum keeps the order of the scalar form it replaced (k ascending, keys
// ascending within a block), so only the block partial's fold into the accumulator moved.
//
// Semantics mirror attn_partial.comp exactly (the kernel this tier replaces at rows≥64):
//  • causal: row r (absolute position pos+qr0+r) attends keys ≤ its own position;
//  • sliding window (window>0): keys ≥ pos_r+1−window; the block loop starts at ROW 0's window
//    base — later rows' bases are ≤ BM−1 positions higher, always inside the first BN block;
//  • ring KV (SWA caches sized below ctx): position j lives at cache row j % (cap/(nkv·hd)) —
//    the same `cap` push-constant mapping as attn_partial's RROW (identity on full-ctx caches).
//    The ring only recycles rows the window mask already excludes, so a recycled row's (real,
//    newer) K value is always masked to −1e30 before softmax;
//  • scale: caller-supplied (gemma4 pushes 1.0); 0 → the 1/√hd default;
//  • GQA: head h reads kv head h/(nh/nkv).
// Q/K/V f16, O f32. hd%4 (vec4 loads), hd ≤ HD_MAX. q/dst rows NOT required padded: q rows ≥
// q_len stage as zeros and dst pad rows are never written (no Internal-buffer requirement).
// KV dtype scope: f16 only — at prefill rows>1 the adapter already dequants q8/block-quant KV
// sides to the f16 ring-layout scratch, so `k_q8_eff`/`v_q8_eff` are false by construction
// there; the gate keeps them excluded explicitly (no native-q8 read variant of this kernel).
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

#ifndef HD_MAX
#define HD_MAX 128
#endif
#if HD_MAX > 256
#define BM 16u // hd=512: halve the row tile to keep the output registers per thread
#else
#define BM 32u
#endif

const uint BN = 64u;            // kv positions per block
const uint THREADS = 256u;
const uint KC = 32u;            // dims per QK chunk
const uint VC = 64u;            // dims per PV chunk
const uint QP4 = KC / 4u + 1u;  // vec4 pitch of a Q or K chunk row (+1 spreads banks)
const uint VP4 = VC / 4u;       // vec4 pitch of a V chunk row
const uint SP = BN + 4u;        // float pitch of a score row (+4 keeps rows 16-byte aligned)
// QK: thread (rg, cg) owns rows rg·RS .. +RS and key columns cg, cg + BN/2.
const uint QK_COLS = BN / 2u;
const uint RS = BM / (THREADS / QK_COLS);
// PV: thread (rp, dq) owns rows rp·RO .. +RO and dims dq·4 .. +4 of each V chunk.
const uint PV_DQ = VC / 4u;
const uint RO = BM / (THREADS / PV_DQ);
const uint NVC = HD_MAX / VC;   // V chunks in the widest head this build takes
// Softmax: SM_T threads per row, SM_C key columns each.
const uint SM_T = THREADS / BM;
const uint SM_C = BN / SM_T;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint q_len; // actual query rows (NOT padded)
    uint kv_len; // this layer's live kv length (positions)
    uint nh;
    uint nkv;
    uint hd;
    uint pos; // absolute position of query row 0
    uint window; // sliding-window size (0 = full causal)
    float scale; // 0 → 1/√hd
    uint cap; // total cache ELEMENTS (ring row mapping); matches attn_partial's push
} pc;
layout(binding = 0) readonly buffer QB { f16vec4 q4[]; }; // [q_len, nh, hd]
layout(binding = 1) readonly buffer KB { f16vec4 k4[]; }; // [rcap, nkv, hd] (ring rows)
layout(binding = 2) readonly buffer VB { f16vec4 v4[]; }; // [rcap, nkv, hd]
layout(binding = 3) writeonly buffer OB { float o[]; };   // [q_len, nh, hd]

shared vec4 Qs[BM * QP4];       // KC-dim chunk of the query tile
shared vec4 KVs[BN * VP4];      // KC-dim chunk of the K block, then VC-dim chunks of V
shared float Ss[BM * SP];       // masked scores, then probabilities
shared float redm[THREADS];     // per-thread partial row max
shared float reds[THREADS];     // per-thread partial row sum
shared float mrow[BM];          // running row max
shared float lrow[BM];          // running row sum
shared float corr[BM];          // per-row rescale for the current block

void main() {
    uint qt = gl_WorkGroupID.x / pc.nh;
    uint h = gl_WorkGroupID.x % pc.nh;
    uint qr0 = qt * BM;
    uint kvh = h / (pc.nh / pc.nkv);
    uint li = gl_LocalInvocationIndex;
    uint hd = pc.hd;
    uint hd4 = hd >> 2u;
    float scale = pc.scale > 0.0 ? pc.scale : 1.0 / sqrt(float(hd));
    // Ring row capacity (attn_partial's RROW): position j lives at cache row j % rcap. Identity
    // on a full-context cache (every live j < kv_len <= rcap).
    uint rcap = (pc.cap > 0u) ? pc.cap / (pc.nkv * hd) : 0u;
#define RROW(j) ((rcap > 0u) ? ((j) % rcap) : (j))

    if (li < BM) {
        mrow[li] = -1e30;
        lrow[li] = 0.0;
    }
    // A tile with no live block reads lrow straight after this, with no barrier in between.
    barrier();

    uint cg = li % QK_COLS;
    uint rg = li / QK_COLS;
    uint dq = li % PV_DQ;
    uint rp = li / PV_DQ;
    uint srow = li / SM_T;
    uint spart = li % SM_T;

    // The QK rows' causal ends and window bases.
    uint qpos[RS];
    uint lo_r[RS];
    [[unroll]] for (uint i = 0u; i < RS; i++) {
        qpos[i] = pc.pos + qr0 + rg * RS + i;
        lo_r[i] = (pc.window > 0u && qpos[i] + 1u > pc.window) ? qpos[i] + 1u - pc.window : 0u;
    }

    vec4 acc_o[RO][NVC];
    [[unroll]] for (uint i = 0u; i < RO; i++) {
        [[unroll]] for (uint c = 0u; c < NVC; c++) {
            acc_o[i][c] = vec4(0.0);
        }
    }

    // kv block range: [row 0's window base, last row's causal end). Later rows' window bases are
    // at most BM-1 > 0 positions above the base — always inside the first block (BM <= 32 < BN).
    uint lo_tile = (pc.window > 0u && pc.pos + qr0 + 1u > pc.window)
                       ? pc.pos + qr0 + 1u - pc.window
                       : 0u;
    uint kvend = min(pc.kv_len, pc.pos + qr0 + BM);

    for (uint b0 = lo_tile; b0 < kvend; b0 += BN) {
        // ── S = Q·Kᵀ over KC-dim chunks ──
        float s[RS][2];
        [[unroll]] for (uint i = 0u; i < RS; i++) {
            s[i][0] = 0.0;
            s[i][1] = 0.0;
        }
        for (uint k0 = 0u; k0 < hd; k0 += KC) {
            // stage Qs: BM rows × KC dims (rows >= q_len and dims >= hd stage zeros — q is sized
            // q_len rows, NOT tile-padded)
            for (uint idx = li; idx < BM * (KC / 4u); idx += THREADS) {
                uint r = idx / (KC / 4u);
                uint c4 = idx % (KC / 4u);
                uint gr = qr0 + r;
                uint d = k0 + c4 * 4u;
                Qs[r * QP4 + c4] = (gr < pc.q_len && d < hd)
                                       ? vec4(q4[(gr * pc.nh + h) * hd4 + (d >> 2u)])
                                       : vec4(0.0);
            }
            // stage K: BN keys × KC dims (positions >= kv_len stage zeros; ring rows via RROW)
            for (uint idx = li; idx < BN * (KC / 4u); idx += THREADS) {
                uint j = idx / (KC / 4u);
                uint c4 = idx % (KC / 4u);
                uint kpos = b0 + j;
                uint d = k0 + c4 * 4u;
                KVs[j * QP4 + c4] = (kpos < pc.kv_len && d < hd)
                                        ? vec4(k4[(RROW(kpos) * pc.nkv + kvh) * hd4 + (d >> 2u)])
                                        : vec4(0.0);
            }
            barrier();
            [[unroll]] for (uint c4 = 0u; c4 < KC / 4u; c4++) {
                vec4 ka = KVs[cg * QP4 + c4];
                vec4 kb = KVs[(cg + QK_COLS) * QP4 + c4];
                [[unroll]] for (uint i = 0u; i < RS; i++) {
                    vec4 qv = Qs[(rg * RS + i) * QP4 + c4];
                    s[i][0] += qv.x * ka.x;
                    s[i][0] += qv.y * ka.y;
                    s[i][0] += qv.z * ka.z;
                    s[i][0] += qv.w * ka.w;
                    s[i][1] += qv.x * kb.x;
                    s[i][1] += qv.y * kb.y;
                    s[i][1] += qv.z * kb.z;
                    s[i][1] += qv.w * kb.w;
                }
            }
            // AFTER all shared reads of this chunk (mmq race lesson).
            barrier();
        }
        // mask (causal end, window base, kv end) and publish this block's scores
        [[unroll]] for (uint i = 0u; i < RS; i++) {
            [[unroll]] for (uint e = 0u; e < 2u; e++) {
                uint j = cg + e * QK_COLS;
                uint kpos = b0 + j;
                bool dead = kpos >= pc.kv_len || kpos > qpos[i] || kpos < lo_r[i];
                Ss[(rg * RS + i) * SP + j] = dead ? -1e30 : s[i][e] * scale;
            }
        }
        barrier();

        // ── online softmax for this block: SM_T threads per row ──
        float sv[SM_C];
        float pmax = -1e30;
        [[unroll]] for (uint c = 0u; c < SM_C; c++) {
            sv[c] = Ss[srow * SP + spart * SM_C + c];
            pmax = max(pmax, sv[c]);
        }
        redm[li] = pmax;
        barrier();
        float mold = mrow[srow];
        float rmax = mold;
        [[unroll]] for (uint t = 0u; t < SM_T; t++) {
            rmax = max(rmax, redm[srow * SM_T + t]);
        }
        float psum = 0.0;
        [[unroll]] for (uint c = 0u; c < SM_C; c++) {
            // dead scores stay EXACTLY zero even in an all-dead block (where rmax would be
            // -1e30 and exp(s - rmax) = exp(0) = 1 — pad rows / window edges hit this).
            float p = (sv[c] > -1e29) ? exp(sv[c] - rmax) : 0.0;
            Ss[srow * SP + spart * SM_C + c] = p;
            psum += p;
        }
        reds[li] = psum;
        barrier();
        if (spart == 0u) {
            float rsum = 0.0;
            [[unroll]] for (uint t = 0u; t < SM_T; t++) {
                rsum += reds[srow * SM_T + t];
            }
            float cf = exp(mold - rmax);
            lrow[srow] = lrow[srow] * cf + rsum;
            mrow[srow] = rmax;
            corr[srow] = cf;
        }

        // ── O = O·corr + P·V over VC-dim chunks of V (KVs restaged per chunk) ──
        [[unroll]] for (uint c = 0u; c < NVC; c++) {
            uint d0 = c * VC;
            if (d0 < hd) {
                for (uint idx = li; idx < BN * VP4; idx += THREADS) {
                    uint j = idx / VP4;
                    uint c4 = idx % VP4;
                    uint kpos = b0 + j;
                    uint d = d0 + c4 * 4u;
                    KVs[j * VP4 + c4] = (kpos < pc.kv_len && d < hd)
                                            ? vec4(v4[(RROW(kpos) * pc.nkv + kvh) * hd4 + (d >> 2u)])
                                            : vec4(0.0);
                }
                barrier();
                [[unroll]] for (uint i = 0u; i < RO; i++) {
                    uint r = rp * RO + i;
                    vec4 part = vec4(0.0);
                    for (uint j = 0u; j < BN; j++) {
                        part += Ss[r * SP + j] * KVs[j * VP4 + dq];
                    }
                    acc_o[i][c] = acc_o[i][c] * corr[r] + part;
                }
                barrier();
            }
        }
    }

    [[unroll]] for (uint i = 0u; i < RO; i++) {
        uint r = rp * RO + i;
        uint gr = qr0 + r;
        float l = lrow[r];
        [[unroll]] for (uint c = 0u; c < NVC; c++) {
            uint d = c * VC + dq * 4u;
            if (gr < pc.q_len && d < hd) {
                vec4 v = (l > 0.0) ? acc_o[i][c] / l : vec4(0.0);
                uint at = (gr * pc.nh + h) * hd + d;
                o[at] = v.x;
                o[at + 1u] = v.y;
                o[at + 2u] = v.z;
                o[at + 3u] = v.w;
            }
        }
    }
}
