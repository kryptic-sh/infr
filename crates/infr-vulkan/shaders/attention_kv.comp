#version 460
// Causal GQA attention over an f16 KV cache, tiled online softmax. One workgroup per (token, head).
// q/k/v f16, o f32. hd <= ATTN_KV_MAX_HD (thread t owns output dims t, t+64, … that fall < hd).
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint q_len; uint kv_len; uint nh; uint nkv; uint hd; uint pos_offset; uint window; float scale; uint cap;
#ifdef COMP
    // -DCOMP builds: the compressed segment's committed rows and positions per block
    // (`Op::Attention::comp`).
    uint comp_len; uint comp_ratio;
#endif
#ifdef KV_BDA
    // -DKV_BDA build: K/V cache base device addresses, uvec2-split (avoids 8-byte push align) — see
    // kv_addr.glsl. K binding 1 / V binding 2 disappear; those descriptor slots go unused (filler).
    uint k_lo; uint k_hi; uint v_lo; uint v_hi;
#endif
} pc;
#ifdef KV_BDA
#include "kv_addr.glsl"
#endif
layout(binding = 0) readonly buffer QB { float16_t q[]; };
// PLANAR Q8_0 KV cache (per-side, -DKQ8 / -DVQ8): codes int8[cap] then scales f16[cap/32] (see
// store_q8). Read as `uint` words; per element = one byte code (from a u32 word) + the block's f16
// scale (scales region at word cap/4). K and V pick their dtype independently → four variants.
// Dequant element `idx`: code byte = word idx/4, lane idx%4 (sign-extended); block = idx/32, scale at
// scale-word cap/4 + block/2, half block&1.
// -DKV_BDA overlays each read onto a 64-bit device-address load (kv_word/kv_half) with NO bound SSBO.
#ifdef KQ8
#ifdef KV_BDA
float dq8k(uint idx) {
    int c = bitfieldExtract(int(kv_word(k_addr, idx >> 2u)), int((idx & 3u) * 8u), 8);
    uint bk = idx >> 5u;
    return unpackHalf2x16(kv_word(k_addr, (pc.cap >> 2u) + (bk >> 1u)))[bk & 1u] * float(c);
}
#else
layout(binding = 1) readonly buffer KB { uint ku[]; };
float dq8k(uint idx) {
    int c = bitfieldExtract(int(ku[idx >> 2u]), int((idx & 3u) * 8u), 8);
    uint bk = idx >> 5u;
    return unpackHalf2x16(ku[(pc.cap >> 2u) + (bk >> 1u)])[bk & 1u] * float(c);
}
#endif
#define KREAD(i) dq8k(i)
#else
#ifdef KV_BDA
#define KREAD(i) kv_half(k_addr, i)
#else
layout(binding = 1) readonly buffer KB { float16_t k[]; };
#define KREAD(i) float(k[i])
#endif
#endif
#ifdef VQ8
#ifdef KV_BDA
float dq8v(uint idx) {
    int c = bitfieldExtract(int(kv_word(v_addr, idx >> 2u)), int((idx & 3u) * 8u), 8);
    uint bk = idx >> 5u;
    return unpackHalf2x16(kv_word(v_addr, (pc.cap >> 2u) + (bk >> 1u)))[bk & 1u] * float(c);
}
#else
layout(binding = 2) readonly buffer VB { uint vu[]; };
float dq8v(uint idx) {
    int c = bitfieldExtract(int(vu[idx >> 2u]), int((idx & 3u) * 8u), 8);
    uint bk = idx >> 5u;
    return unpackHalf2x16(vu[(pc.cap >> 2u) + (bk >> 1u)])[bk & 1u] * float(c);
}
#endif
#define VREAD(i) dq8v(i)
#else
#ifdef KV_BDA
#define VREAD(i) kv_half(v_addr, i)
#else
layout(binding = 2) readonly buffer VB { float16_t v[]; };
#define VREAD(i) float(v[i])
#endif
#endif
#ifdef USE_PARAMS
// Record-once decode: pos_offset comes from a host-updated params SSBO so the buffer can be replayed.
// `o` moves to binding 4 (params takes binding 3) so the recorder's reads|writes split is output-last.
layout(binding = 3) readonly buffer PB { uint p_pos; uint p_kvlen; };
layout(binding = 4) buffer OB { float o[]; };
#elif defined(COMP)
// -DCOMP builds (`attention_kv_comp*`): DeepSeek V4's compressed key segment, `[comp_len rows,
// nkv * hd]` f16, attended after the raw keys in the same online softmax and serving as its own
// values (`Op::Attention::comp`). It binds after the optional sinks; the optional `-DCOMP_BIAS`
// `[q_len, comp_len]` f32 score bias (`Op::TopkMask`'s output) after it; `o` last.
#if defined(SINKS) && defined(COMP_BIAS)
layout(binding = 3) readonly buffer SB { float sink[]; };
layout(binding = 4) readonly buffer CB { float16_t ck[]; };
layout(binding = 5) readonly buffer CBB { float cbias[]; };
layout(binding = 6) buffer OB { float o[]; };
#elif defined(SINKS)
layout(binding = 3) readonly buffer SB { float sink[]; };
layout(binding = 4) readonly buffer CB { float16_t ck[]; };
layout(binding = 5) buffer OB { float o[]; };
#elif defined(COMP_BIAS)
layout(binding = 3) readonly buffer CB { float16_t ck[]; };
layout(binding = 4) readonly buffer CBB { float cbias[]; };
layout(binding = 5) buffer OB { float o[]; };
#else
layout(binding = 3) readonly buffer CB { float16_t ck[]; };
layout(binding = 4) buffer OB { float o[]; };
#endif
#elif defined(SINKS) && defined(BIAS)
// -DSINKS -DBIAS build (`attention_kv_sinks_bias`): both extras at once — DeepSeek V4's CSA
// layers carry `attn_sinks` AND the lightning indexer's top-k mask on the SAME attention. Sinks
// at binding 3, bias at binding 4, `o` last at 5 — same order MLA's `-DFREQ_FACTORS -DKEY_BIAS`
// build binds its two optionals in (see `mla.comp`).
layout(binding = 3) readonly buffer SB { float sink[]; };
layout(binding = 4) readonly buffer BB { float bias[]; };
layout(binding = 5) buffer OB { float o[]; };
#elif defined(SINKS)
// -DSINKS build (`attention_kv_sinks`): per-head attention-sink logits `[nh]` at binding 3, `o`
// last at 4. One extra logit per head that joins the softmax MAX and DENOMINATOR and contributes
// no value — deepseek4's `attn_sinks`, see `Op::Attention::sinks`. Only the plain f16-KV static
// build carries it (no Q8/BDA/params twins): the adapter routes a sinks op here and refuses the
// shapes this build can't serve rather than silently dropping the sink.
layout(binding = 3) readonly buffer SB { float sink[]; };
layout(binding = 4) buffer OB { float o[]; };
#elif defined(BIAS)
// -DBIAS build (`attention_kv_bias`): additive per-(row, key) score mask `[q_len, kv_len]` at
// binding 3, `o` last at 4 — `Op::Attention::key_bias`, deepseek4 CSA's top-k mask
// (`Op::TopkMask`'s output). Same plain-f16-KV-only restriction as SINKS.
layout(binding = 3) readonly buffer BB { float bias[]; };
layout(binding = 4) buffer OB { float o[]; };
#else
layout(binding = 3) buffer OB { float o[]; };
#endif

// Add the score mask at key POSITION `j` (the loop variable below, NOT the ring-adjusted row) for
// query row `ti`. The no-bias build adds NOTHING rather than a literal 0.0 — same reasoning as
// `mla.comp`'s `ADD_KEY_BIAS`: `x + 0.0` is not the identity on `-0.0`, so a shared expression
// would cost every existing build an instruction and an IEEE corner it never had.
#ifdef BIAS
#define ADD_BIAS(s, row, j) ((s) + bias[(row) * pc.kv_len + (j)])
#else
#define ADD_BIAS(s, row, j) (s)
#endif
#ifdef COMP_BIAS
#define ADD_COMP_BIAS(s, row, j) ((s) + cbias[(row) * pc.comp_len + (j)])
#else
#define ADD_COMP_BIAS(s, row, j) (s)
#endif

const uint TILE = 1024u;
// Widest head this kernel serves: the staged query, and the output dims its 64 threads own
// (`ATTN_KV_ACC` each). The host refuses wider heads (`ATTN_KV_MAX_HD` in adapter.rs, kept in
// step by `attention_kv_bound_matches_host`).
#define ATTN_KV_MAX_HD 512
#define ATTN_KV_ACC (ATTN_KV_MAX_HD / 64)
shared float q_sh[ATTN_KV_MAX_HD];
shared float sc[1024];
shared float red[64];

void main() {
    uint t = gl_LocalInvocationID.x;
#ifdef KV_BDA
    // Wave-uniform K/V cache base pointers, set ONCE (see kv_addr.glsl). Every KREAD/VREAD below
    // adds a u32 element offset to these before the uint64_t cast → saddr scalar-base loads.
    k_addr = kv_base(pc.k_lo, pc.k_hi);
    v_addr = kv_base(pc.v_lo, pc.v_hi);
#endif
    // Flat workgroup index across `Recorder::dispatch_wide`'s 2-D split of a grid wider than
    // `maxComputeWorkGroupCount[0]`; equal to `gl_WorkGroupID.x` when unsplit. A padding
    // workgroup returns whole, before any barrier or subgroup op, so control flow stays uniform.
    uint unit = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (unit >= pc.q_len * pc.nh) { return; }
    uint ti = unit / pc.nh;
    uint h = unit % pc.nh;
#ifdef USE_PARAMS
    uint pos_offset = p_pos;
#else
    uint pos_offset = pc.pos_offset;
#endif
    uint qpos = pos_offset + ti;
    uint kvlen = qpos + 1u;
    // Sliding-window attention: attend only keys j with j > qpos - window (j >= lo). 0 = full causal.
    uint lo = (pc.window > 0u && qpos + 1u > pc.window) ? (qpos + 1u - pc.window) : 0u;
    uint kvh = h / (pc.nh / pc.nkv);
    uint hd = pc.hd;
    // SWA ring cache: row capacity = cap / row width. Key/value POSITION j lives at row j % rcap —
    // the ring only ever recycles rows whose positions the sliding-window mask (lo) already
    // excludes, so this is exact. On a full-context cache j < kv_len <= rcap: identity.
    uint rcap = (pc.cap > 0u) ? pc.cap / (pc.nkv * hd) : 0u;
    // scale > 0 → caller-supplied (gemma4 uses 1.0, QK-norm controls magnitude); else 1/√hd default.
    float scale = pc.scale > 0.0 ? pc.scale : 1.0 / sqrt(float(hd));

    uint qbase = (ti * pc.nh + h) * hd;
    for (uint d = t; d < hd; d += 64u) { q_sh[d] = float(q[qbase + d]); }
    barrier();

    float m = -3.0e38;
    float l = 0.0;
    // Up to ATTN_KV_ACC output dims per thread (t + c*64), covering hd up to ATTN_KV_MAX_HD.
    float acc[ATTN_KV_ACC];
    for (uint c = 0u; c < uint(ATTN_KV_ACC); c++) { acc[c] = 0.0; }

    // Start at the window's tile: skip tiles entirely below `lo` (fully masked). This guarantees
    // every processed tile has ≥1 in-window key, so `mnew` is finite and masked keys get exp→0
    // (a fully-masked tile would leave mnew at the -3e38 sentinel → exp(0)=1, corrupting the sum).
    for (uint ts = (lo / TILE) * TILE; ts < kvlen; ts += TILE) {
        uint te = min(ts + TILE, kvlen);
        float lmax = -3.0e38;
        for (uint j = ts + t; j < te; j += 64u) {
            float s;
            if (j < lo) {
                s = -3.0e38; // outside the sliding window → masked (exp → 0)
            } else {
                uint jr = (rcap > 0u) ? (j % rcap) : j;
                uint kbase = (jr * pc.nkv + kvh) * hd;
                float dotv = 0.0;
                for (uint d = 0u; d < hd; d++) { dotv += q_sh[d] * KREAD(kbase + d); }
                s = ADD_BIAS(dotv * scale, ti, j);
            }
            sc[j - ts] = s;
            lmax = max(lmax, s);
        }
        red[t] = lmax;
        barrier();
        for (uint stride = 32u; stride > 0u; stride /= 2u) {
            if (t < stride) { red[t] = max(red[t], red[t + stride]); }
            barrier();
        }
        float mnew = max(m, red[0]);
        barrier();

        float lsum = 0.0;
        for (uint j = ts + t; j < te; j += 64u) {
            float p = exp(sc[j - ts] - mnew);
            sc[j - ts] = p;
            lsum += p;
        }
        red[t] = lsum;
        barrier();
        for (uint stride = 32u; stride > 0u; stride /= 2u) {
            if (t < stride) { red[t] += red[t + stride]; }
            barrier();
        }
        float tsum = red[0];

        float corr = exp(m - mnew);
        l = l * corr + tsum;
        m = mnew;
        for (uint c = 0u; c < uint(ATTN_KV_ACC); c++) {
            uint d = t + c * 64u;
            if (d < hd) {
                float a = 0.0;
                for (uint j = ts; j < te; j++) {
                    uint jr = (rcap > 0u) ? (j % rcap) : j;
                    a += sc[j - ts] * VREAD((jr * pc.nkv + kvh) * hd + d);
                }
                acc[c] = acc[c] * corr + a;
            }
        }
        barrier();
    }

#ifdef COMP
    // The compressed segment: blocks j < (qpos + 1) / comp_ratio (integer floor, so a block is
    // visible from the token that completes it) and j < comp_len, folded into the SAME running
    // (m, l, acc) as the raw tiles above, so one softmax covers both — the reference's attention
    // over its concatenated `[raw | compressed]` cache. Block j is row j (no ring), and its key
    // row is also its value row. The tile body is the raw loop's with those reads swapped in; the
    // raw loop is left as it was so the builds without COMP compile to the same code.
    //
    // A tile whose every key the bias masks to -inf is harmless here, unlike in the raw loop:
    // the raw tiles always include the query's own key, so `m` is finite before this loop and
    // `mnew = max(m, -inf)` stays finite, sending each masked key's exp to exactly 0.
    uint nvis = min((qpos + 1u) / pc.comp_ratio, pc.comp_len);
    for (uint ts = 0u; ts < nvis; ts += TILE) {
        uint te = min(ts + TILE, nvis);
        float lmax = -3.0e38;
        for (uint j = ts + t; j < te; j += 64u) {
            uint kbase = (j * pc.nkv + kvh) * hd;
            float dotv = 0.0;
            for (uint d = 0u; d < hd; d++) { dotv += q_sh[d] * float(ck[kbase + d]); }
            float s = ADD_COMP_BIAS(dotv * scale, ti, j);
            sc[j - ts] = s;
            lmax = max(lmax, s);
        }
        red[t] = lmax;
        barrier();
        for (uint stride = 32u; stride > 0u; stride /= 2u) {
            if (t < stride) { red[t] = max(red[t], red[t + stride]); }
            barrier();
        }
        float mnew = max(m, red[0]);
        barrier();

        float lsum = 0.0;
        for (uint j = ts + t; j < te; j += 64u) {
            float p = exp(sc[j - ts] - mnew);
            sc[j - ts] = p;
            lsum += p;
        }
        red[t] = lsum;
        barrier();
        for (uint stride = 32u; stride > 0u; stride /= 2u) {
            if (t < stride) { red[t] += red[t + stride]; }
            barrier();
        }
        float tsum = red[0];

        float corr = exp(m - mnew);
        l = l * corr + tsum;
        m = mnew;
        for (uint c = 0u; c < uint(ATTN_KV_ACC); c++) {
            uint d = t + c * 64u;
            if (d < hd) {
                float a = 0.0;
                for (uint j = ts; j < te; j++) {
                    a += sc[j - ts] * float(ck[(j * pc.nkv + kvh) * hd + d]);
                }
                acc[c] = acc[c] * corr + a;
            }
        }
        barrier();
    }
#endif

    uint obase = (ti * pc.nh + h) * hd;
#ifdef SINKS
    // Fold the sink into the finished (m, l) the same way the tile loop folds each new tile: it
    // joins the max, the running sum is rescaled by exp(m - mfin), and the sink's own exp is added
    // to the DENOMINATOR only. Algebraically identical to ggml's single-pass
    // `max = MAX(max, sk[h]); sum += expf(sk[h] - max)`, and the acc rescale is what keeps the
    // numerators on the new max.
    float sk_h = sink[h];
    float mfin = max(m, sk_h);
    float scorr = exp(m - mfin);
    l = l * scorr + exp(sk_h - mfin);
    for (uint c = 0u; c < uint(ATTN_KV_ACC); c++) { acc[c] *= scorr; }
#endif
    float inv = 1.0 / l;
    for (uint c = 0u; c < uint(ATTN_KV_ACC); c++) {
        uint d = t + c * 64u;
        if (d < hd) { o[obase + d] = acc[c] * inv; }
    }
}
