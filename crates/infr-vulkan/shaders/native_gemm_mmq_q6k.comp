#version 460
// Tiled dp4a (mmq) GEMM for stacked Q6_K experts (the MoE down projection): C[m,n] = A[m,k]·W[ids]ᵀ
// via hardware int8 dot-product. Q6_K is symmetric (no min): w = d·sc·(q6 − 32). We bake the (q6 − 32)
// centering into a signed int8 weight and fold d·sc into a per-sub-block float scale. Activations are
// pre-quantized to int8 per 32-block (qa/dact from quant_q8; the per-block sum/min is unused — Q6_K has
// no min term). The Q6_K scale granularity is 16 elements (one i8 scale per sub-block); the K loop steps
// 32-element groups = two sub-blocks, each with its own (d·sc) and integer sum, sharing the activation's
// 32-block scale (dact). Mirrors
// native_gemm_mmq_q4k (register-blocked 64×64 tile, TM×TN = 4×4, scalar dp4a — RADV int8 WMMA hangs).
// w_base = expert·stride. Requires n%64, k%32 (Q6_K tensors are k%256).
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

#ifndef BM_TILE
#define BM_TILE 64u
#endif
const uint BM = BM_TILE; // row tile — 64 default, EXPERT_GRID batched-MoE callers may
                         // override smaller (e.g. 32) to fit small per-expert row counts

#ifndef BN_TILE
#define BN_TILE 64u
#endif
const uint BN = BN_TILE; // col tile — 64 default, EXPERT_GRID small-row callers may widen (128)
// The K loop steps one 32-element GROUP per iteration — two Q6_K 16-element scale sub-blocks,
// kept as separate integer sums (qsA/qsB) so each still gets its own int8 scale. A 32-group never
// straddles a 256-superblock, and it is exactly one activation `dact` block. (The loop used to
// step a single 16-sub-block: twice the barriers for the same dp4a work, which on RDNA2 left this
// kernel ~3.5x slower than the Q4_K mmq at the same shape.)
const uint GRP = 32u;       // elements per K step
const uint WPB = GRP / 4u;  // 8 packed-int8 u32 words per group (words 0-3: scale A, 4-7: B)
const uint TM = 4u;
const uint TN = 4u;
const uint THREADS = (BM / TM) * (BN / TN); // 256
const uint SP = WPB + 1u;

layout(local_size_x = THREADS, local_size_y = 1, local_size_z = 1) in;
#ifdef PAGED
// -DPAGED appends the arena's 64-bit base address (lo/hi) + per-slot byte stride — see
// native_weight_addr.glsl. pc.w_base carries the layer's LUT window base; pc.m is unused.
layout(push_constant) uniform PC {
    uint m; uint n; uint k; uint w_base; uint arena_lo; uint arena_hi; uint slot_bytes;
} pc;
#elif defined(STREAMED)
// -DSTREAMED (resident-BDA): the stacked weight tensor lives in a resident BDA arena at the 64-bit
// base passed as arena_lo/arena_hi — same rb() pointer read as PAGED but with NO LUT and NO slot
// stride (the base already points at THIS tensor). Under EXPERT_GRID, pc.m is the per-expert
// BYTE stride applied on the pointer; pc.w_base keeps only the small within-bank element offset.
// Additive: non-STREAMED builds are byte-identical.
layout(push_constant) uniform PC {
    uint m; uint n; uint k; uint w_base; uint arena_lo; uint arena_hi;
} pc;
#else
layout(push_constant) uniform PC { uint m; uint n; uint k; uint w_base; } pc;
#endif
layout(binding = 0) readonly buffer QA { uint qa[]; };          // [m, k/4] packed int8 activations
// The same activations 16 bytes at a time (a row's 32-group starts 16-aligned: k%32 ⇒ kw%8).
layout(binding = 0) readonly buffer QA4 { uvec4 qa4[]; };
layout(binding = 1) readonly buffer DA { float16_t dact[]; };   // [m, k/32]
#if !defined(PAGED) && !defined(STREAMED)
layout(binding = 2) readonly buffer WB { uint nw[]; };          // stacked Q6_K weight bytes
#endif
#ifdef PAGED
// PAGED (implies EXPERT_GRID): `nw` is a GpuPager arena of uniform slots; see
// native_gemm_mmq_q2_k.comp's PAGED doc (word base not slot index, pc.w_base = layer_base, pc.m
// unused, rb() chokepoint).
layout(binding = 3) readonly buffer LUT { uint lut[]; };
layout(binding = 4) readonly buffer CNT { uint counts[]; };
layout(binding = 5) readonly buffer OFF { uint offsets[]; };
layout(binding = 6) writeonly buffer CB { float c[]; };         // [n_pairs, n] packed
#elif defined(EXPERT_GRID)
// Batched-MoE all-experts-in-one-dispatch: gl_WorkGroupID.y = expert id; the packed activation
// rows for expert e live at [offsets[e], offsets[e]+counts[e]) (bucket layout). pc.m is repurposed
// as the per-expert weight stride (elements). Row tiles past the segment exit immediately; row
// stores are clipped to the segment (rows are packed — no per-expert padding to stomp). The two
// extra readonly inputs sit before `c` so the recorder's inputs-first/outputs-last order holds.
layout(binding = 3) readonly buffer CNT { uint counts[]; };
layout(binding = 4) readonly buffer OFF { uint offsets[]; };
layout(binding = 5) writeonly buffer CB { float c[]; };         // [n_pairs, n] packed
#else
layout(binding = 3) writeonly buffer CB { float c[]; };         // [m, n]
#endif

shared uint As[BM * SP];
shared uint Bs[BN * SP];
shared float Bdl[BN];
shared float Bdl2[BN];

#if defined(PAGED) || defined(STREAMED)
// Arena read via 64-bit device address (see native_weight_addr.glsl): `w_addr` (set in main) is
// this expert's slot byte base; rb() reads a byte through it. The LUT stores the SLOT INDEX,
// scaled onto the arena base with a 64-bit multiply (replaces the u32 word-base SSBO read).
#include "native_weight_addr.glsl"
uint rb(uint byte) { return (arena_word(byte >> 2) >> ((byte & 3u) * 8u)) & 0xFFu; }
#else
uint rb(uint byte) { return (nw[byte >> 2] >> ((byte & 3u) * 8u)) & 0xFFu; }
#endif
uint ru16(uint byte) { return rb(byte) | (rb(byte + 1u) << 8u); }
#if defined(PAGED) || defined(STREAMED)
uint rw_aligned(uint wi) { return arena_word(wi); }
#else
uint rw_aligned(uint wi) { return nw[wi]; }
#endif
// The 4 bytes starting at `byte`, little-endian. Q6_K superblocks are 210 bytes, so every odd
// block starts 2 bytes off a word boundary: two aligned loads + a funnel shift instead of four
// byte loads.
#if defined(PAGED) || defined(STREAMED)
uvec4 rw4_aligned(uint wi) { return arena_word4(wi); }
#else
uvec4 rw4_aligned(uint wi) { return uvec4(nw[wi], nw[wi + 1u], nw[wi + 2u], nw[wi + 3u]); }
#endif
// The 16 bytes starting at `byte` (2-aligned at worst): one 128-bit load, plus one more word and a
// funnel shift when the superblock sits on the odd half-word.
uvec4 rw4(uint byte) {
    uint wi = byte >> 2u;
    uint sh = (byte & 3u) * 8u;
    uvec4 a = rw4_aligned(wi);
    if (sh == 0u) { return a; }
    uint e = rw_aligned(wi + 4u);
    return uvec4((a.x >> sh) | (a.y << (32u - sh)), (a.y >> sh) | (a.z << (32u - sh)),
                 (a.z >> sh) | (a.w << (32u - sh)), (a.w >> sh) | (e << (32u - sh)));
}
uint rw(uint byte) {
    uint wi = byte >> 2u;
    uint sh = (byte & 3u) * 8u;
    uint lo = rw_aligned(wi);
    return sh == 0u ? lo : ((lo >> sh) | (rw_aligned(wi + 1u) << (32u - sh)));
}
float f16tof32(uint bits) { return unpackHalf2x16(bits & 0xffffu).x; }
int sgn8(uint b) { return int(b << 24u) >> 24; }

void main() {
#ifdef STREAMED
    w_addr = arena_base(pc.arena_lo, pc.arena_hi); // resident tensor base byte address; NO LUT/slot multiply
#endif
    uint ngrp = pc.k / GRP;       // 32-element groups along k
    uint nblk32 = pc.k / 32u;     // activation 32-blocks along k
    uint kw = pc.k / 4u;
    uint tilesN = pc.n / BN;
#ifdef EXPERT_GRID
    uint ex = gl_WorkGroupID.y;
    uint cnt = counts[ex];
    if ((gl_WorkGroupID.x / tilesN) * BM >= cnt) { return; }
    uint wgRow = offsets[ex] + (gl_WorkGroupID.x / tilesN) * BM;
    uint rowEnd = offsets[ex] + cnt;
#ifdef PAGED
    // Resolved AFTER the count early-exit: a bucket with count 0 was never routed, so its LUT
    // entry may be stale/absent — no workgroup that would read it gets here.
    w_addr = arena_base(pc.arena_lo, pc.arena_hi)
             + uint64_t(lut[pc.w_base + ex]) * uint64_t(pc.slot_bytes);
    uint wbase = 0u;
#elif defined(STREAMED)
    // Expert base scaled onto the 64-bit pointer — pc.m is REPURPOSED as the per-expert BYTE
    // stride in this build (same convention as native_gemv_id.comp's STREAMED arm); pc.w_base
    // keeps its small within-bank element offset. Kills the u32 `ex * stride` element multiply.
    w_addr += uint64_t(ex) * uint64_t(pc.m);
    uint wbase = pc.w_base;
#else
    uint wbase = pc.w_base + ex * pc.m;
#endif
#else
    uint wgRow = (gl_WorkGroupID.x / tilesN) * BM;
    uint wbase = pc.w_base;
#endif
    uint wgCol = (gl_WorkGroupID.x % tilesN) * BN;
    uint li = gl_LocalInvocationIndex;
    uint tr = li / (BN / TN);
    uint tc = li % (BN / TN);

    float acc[TM][TN];
    [[unroll]] for (uint i = 0u; i < TM; i++)
        [[unroll]] for (uint j = 0u; j < TN; j++) acc[i][j] = 0.0;

#ifdef EXPERT_GRID
    // Dead-row mask for partial expert tiles — see native_gemm_mmq_q4k.comp's `live` doc (same
    // reasoning, same wave-coherent tr stripe; staging + both barriers stay unconditional).
    bool live = (wgRow + tr * TM) < rowEnd;
#else
    const bool live = true;
#endif

    // Register prefetch (as in native_gemm_mmq_q4k): group g+1's global loads are issued before
    // group g's dp4a work and written to shared after the trailing barrier. All loads are 128-bit.
    const uint NA = (BM * (WPB / 4u) + THREADS - 1u) / THREADS;
    const uint NB = (BN * (WPB / 4u) + THREADS - 1u) / THREADS;
    const uint NH = (BN + THREADS - 1u) / THREADS;
    uvec4 ra[NA];
    uvec4 rql[NB];
    uvec4 rqh[NB];
    uint rog[NB];
    uint rsc[NH];
    uint rd[NH];
#define PREFETCH(gg) \
    [[unroll]] for (uint u = 0u; u < NA; u++) { \
        uint idx = li + u * THREADS; \
        if (idx < BM * (WPB / 4u)) { \
            uint r = idx / (WPB / 4u); \
            uint h = idx % (WPB / 4u); \
            ra[u] = qa4[((wgRow + r) * kw + (gg) * WPB) / 4u + h]; \
        } \
    } \
    [[unroll]] for (uint u = 0u; u < NH; u++) { \
        uint cc = li + u * THREADS; \
        if (cc < BN) { \
            uint gstart = wbase + (wgCol + cc) * pc.k + (gg) * GRP; \
            uint bd = (gstart / 256u) * 210u; \
            uint p0 = gstart % 256u; \
            uint sc_idx = (p0 / 128u) * 8u + 2u * ((p0 % 128u) / 32u); \
            rsc[u] = ru16(bd + 192u + sc_idx); \
            rd[u] = ru16(bd + 208u); \
        } \
    } \
    [[unroll]] for (uint u = 0u; u < NB; u++) { \
        uint idx = li + u * THREADS; \
        if (idx < BN * (WPB / 4u)) { \
            uint cc = idx / (WPB / 4u); \
            uint h = idx % (WPB / 4u); \
            uint gstart = wbase + (wgCol + cc) * pc.k + (gg) * GRP; \
            uint bd = (gstart / 256u) * 210u; \
            uint p0 = gstart % 256u; \
            uint hf = p0 / 128u; \
            uint og = (p0 % 128u) / 32u; \
            rog[u] = og; \
            rql[u] = rw4(bd + hf * 64u + (og & 1u) * 32u + h * 16u); \
            rqh[u] = rw4(bd + 128u + hf * 32u + h * 16u); \
        } \
    }
    PREFETCH(0u)
    for (uint g = 0u; g < ngrp; g++) {
        [[unroll]] for (uint u = 0u; u < NA; u++) {
            uint idx = li + u * THREADS;
            if (idx < BM * (WPB / 4u)) {
                uint o = (idx / (WPB / 4u)) * SP + (idx % (WPB / 4u)) * 4u;
                As[o] = ra[u].x; As[o + 1u] = ra[u].y; As[o + 2u] = ra[u].z; As[o + 3u] = ra[u].w;
            }
        }
        // Per column: the group's two 16-sub-block scales (d * sc[sub]).
        [[unroll]] for (uint u = 0u; u < NH; u++) {
            uint cc = li + u * THREADS;
            if (cc < BN) {
                float d = f16tof32(rd[u]);
                Bdl[cc] = d * float(sgn8(rsc[u] & 0xFFu));
                Bdl2[cc] = d * float(sgn8(rsc[u] >> 8u));
            }
        }
        // Per (column, word): 4 consecutive 6-bit codes from one ql word + one qh word, re-centred
        // to signed int8 (q - 32) lane-wise without carries: x = q ^ 0x20 is (q - 32) as a 6-bit
        // two's-complement value, then bit 5 is copied into bits 6-7 to sign-extend it.
        [[unroll]] for (uint u = 0u; u < NB; u++) {
            uint idx = li + u * THREADS;
            if (idx < BN * (WPB / 4u)) {
                uint og = rog[u];
                uvec4 lo4 = (og < 2u) ? (rql[u] & 0x0F0F0F0Fu) : ((rql[u] >> 4u) & 0x0F0F0F0Fu);
                uvec4 q = lo4 | (((rqh[u] >> (2u * og)) & 0x03030303u) << 4u);
                uvec4 x = q ^ 0x20202020u;
                uvec4 sb = x & 0x20202020u;
                uvec4 v = x | (sb << 1u) | (sb << 2u);
                uint o = (idx / (WPB / 4u)) * SP + (idx % (WPB / 4u)) * 4u;
                Bs[o] = v.x; Bs[o + 1u] = v.y; Bs[o + 2u] = v.z; Bs[o + 3u] = v.w;
            }
        }
        barrier();
        if (g + 1u < ngrp) {
            PREFETCH(g + 1u)
        }

        if (live) {
        int qsA[TM][TN];
        int qsB[TM][TN];
        [[unroll]] for (uint i = 0u; i < TM; i++)
            [[unroll]] for (uint j = 0u; j < TN; j++) { qsA[i][j] = 0; qsB[i][j] = 0; }
        [[unroll]] for (uint p = 0u; p < WPB; p++) {
            int av[TM];
            int bv[TN];
            [[unroll]] for (uint i = 0u; i < TM; i++) av[i] = int(As[(tr * TM + i) * SP + p]);
            [[unroll]] for (uint j = 0u; j < TN; j++) bv[j] = int(Bs[(tc * TN + j) * SP + p]);
            if (p < WPB / 2u) {
                [[unroll]] for (uint i = 0u; i < TM; i++)
                    [[unroll]] for (uint j = 0u; j < TN; j++)
                        qsA[i][j] = dotPacked4x8AccSatEXT(av[i], bv[j], qsA[i][j]);
            } else {
                [[unroll]] for (uint i = 0u; i < TM; i++)
                    [[unroll]] for (uint j = 0u; j < TN; j++)
                        qsB[i][j] = dotPacked4x8AccSatEXT(av[i], bv[j], qsB[i][j]);
            }
        }
        float dval[TM];
        [[unroll]] for (uint i = 0u; i < TM; i++)
            dval[i] = float(dact[(wgRow + tr * TM + i) * nblk32 + g]);
        [[unroll]] for (uint j = 0u; j < TN; j++) {
            float dA = Bdl[tc * TN + j];
            float dB = Bdl2[tc * TN + j];
            [[unroll]] for (uint i = 0u; i < TM; i++) {
                // Two separate accumulations, sub-block A then B, in the exact order the old
                // one-sub-block-per-iteration loop used: the output stays bit-identical.
                acc[i][j] += dval[i] * dA * float(qsA[i][j]);
                acc[i][j] += dval[i] * dB * float(qsB[i][j]);
            }
        }
        }
        // Keep the second barrier INSIDE the loop: a fast thread must not restage As/Bs/Bdl while
        // a slow one is still reading them (the mmq barrier-race lesson).
        barrier();
    }

    [[unroll]] for (uint i = 0u; i < TM; i++) {
        uint rr = wgRow + tr * TM + i;
#ifdef EXPERT_GRID
        if (rr >= rowEnd) { continue; }
#endif
        [[unroll]] for (uint j = 0u; j < TN; j++) {
            c[rr * pc.n + (wgCol + tc * TN + j)] = acc[i][j];
        }
    }
}
