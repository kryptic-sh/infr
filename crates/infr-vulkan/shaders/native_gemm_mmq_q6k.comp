#version 460
// Tiled dp4a (mmq) GEMM for stacked Q6_K experts (the MoE down projection): C[m,n] = A[m,k]·W[ids]ᵀ
// via hardware int8 dot-product. Q6_K is symmetric (no min): w = d·sc·(q6 − 32). We bake the (q6 − 32)
// centering into a signed int8 weight and fold d·sc into a per-sub-block float scale. Activations are
// pre-quantized to int8 per 32-block (qa/dact from quant_q8; the per-block sum/min is unused — Q6_K has
// no min term). Each k-step stages one 32-element chunk = the activation's 32-block (one dact) = TWO
// Q6_K scale sub-blocks (one i8 scale per 16 elements), so each column carries two d·sc (Bdl[2c],
// Bdl[2c+1]) and the dp4a sum splits into the words of each half. Mirrors native_gemm_mmq_q4k
// (register-blocked 64×64 tile, TM×TN = 4×4, scalar dp4a — RADV int8 WMMA hangs).
//
// Why 32 per step and word loads: the old 16-per-step loop ran twice the barriers for half the dp4a
// work per staging round and decoded every int8 weight from two single-byte reads (8 global loads
// per packed word); at ERNIE-4.5-21B-A3B's k=1536 down shape that kernel ran at ~1/3.7 of the Q4_K
// one. A chunk's ql and qh bytes are contiguous runs, so each packed word now takes one ql and one
// qh word (two of each when the 210-byte block sits 2 bytes off a word boundary — see `rw`).
// w_base = expert·stride. Requires n%64, k%32.
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

#ifndef BM_TILE
#define BM_TILE 64u
#endif
const uint BM = BM_TILE; // row tile — 64 default, EXPERT_GRID batched-MoE callers may
                         // override smaller (e.g. 32) to fit small per-expert row counts

#ifndef BN_TILE
#define BN_TILE 64u
#endif
const uint BN = BN_TILE; // col tile — 64 default, EXPERT_GRID small-row callers may widen (128)
const uint BLK = 32u;       // one k-step: the activation 32-block = two Q6_K scale sub-blocks
const uint WPB = BLK / 4u;  // 8 packed-int8 u32 words per step (words 0-3: first sub-block)
const uint TM = 4u;
const uint TN = 4u;
const uint THREADS = (BM / TM) * (BN / TN); // 256
const uint SP = WPB + 1u;

layout(local_size_x = THREADS, local_size_y = 1, local_size_z = 1) in;
#ifdef PAGED
// -DPAGED appends the arena's 64-bit base address (lo/hi) + per-slot byte stride — see
// native_weight_addr.glsl. pc.w_base carries the layer's LUT window base; pc.m is unused.
layout(push_constant) uniform PC {
    uint m; uint n; uint k; uint w_base; uint arena_lo; uint arena_hi; uint slot_bytes;
} pc;
#elif defined(STREAMED)
// -DSTREAMED (resident-BDA): the stacked weight tensor lives in a resident BDA arena at the 64-bit
// base passed as arena_lo/arena_hi — same rb() pointer read as PAGED but with NO LUT and NO slot
// stride (the base already points at THIS tensor). Under EXPERT_GRID, pc.m is the per-expert
// BYTE stride applied on the pointer; pc.w_base keeps only the small within-bank element offset.
// Additive: non-STREAMED builds are byte-identical.
layout(push_constant) uniform PC {
    uint m; uint n; uint k; uint w_base; uint arena_lo; uint arena_hi;
} pc;
#else
layout(push_constant) uniform PC { uint m; uint n; uint k; uint w_base; } pc;
#endif
layout(binding = 0) readonly buffer QA { uint qa[]; };          // [m, k/4] packed int8 activations
layout(binding = 1) readonly buffer DA { float16_t dact[]; };   // [m, k/32]
#if !defined(PAGED) && !defined(STREAMED)
layout(binding = 2) readonly buffer WB { uint nw[]; };          // stacked Q6_K weight bytes
#endif
#ifdef PAGED
// PAGED (implies EXPERT_GRID): `nw` is a GpuPager arena of uniform slots; see
// native_gemm_mmq_q2_k.comp's PAGED doc (word base not slot index, pc.w_base = layer_base, pc.m
// unused, rb() chokepoint).
layout(binding = 3) readonly buffer LUT { uint lut[]; };
layout(binding = 4) readonly buffer CNT { uint counts[]; };
layout(binding = 5) readonly buffer OFF { uint offsets[]; };
layout(binding = 6) writeonly buffer CB { float c[]; };         // [n_pairs, n] packed
#elif defined(EXPERT_GRID)
// Batched-MoE all-experts-in-one-dispatch: gl_WorkGroupID.y = expert id; the packed activation
// rows for expert e live at [offsets[e], offsets[e]+counts[e]) (bucket layout). pc.m is repurposed
// as the per-expert weight stride (elements). Row tiles past the segment exit immediately; row
// stores are clipped to the segment (rows are packed — no per-expert padding to stomp). The two
// extra readonly inputs sit before `c` so the recorder's inputs-first/outputs-last order holds.
layout(binding = 3) readonly buffer CNT { uint counts[]; };
layout(binding = 4) readonly buffer OFF { uint offsets[]; };
layout(binding = 5) writeonly buffer CB { float c[]; };         // [n_pairs, n] packed
#else
layout(binding = 3) writeonly buffer CB { float c[]; };         // [m, n]
#endif

shared uint As[BM * SP];
shared uint Bs[BN * SP];
shared float Bdl[2u * BN]; // d·sc per column for the step's two 16-element sub-blocks

#if defined(PAGED) || defined(STREAMED)
// Arena read via 64-bit device address (see native_weight_addr.glsl): `w_addr` (set in main) is
// this expert's slot byte base; rb() reads a byte through it. The LUT stores the SLOT INDEX,
// scaled onto the arena base with a 64-bit multiply (replaces the u32 word-base SSBO read).
#include "native_weight_addr.glsl"
uint rword(uint wi) { return arena_word(wi); }
#else
uint rword(uint wi) { return nw[wi]; }
#endif
uint rb(uint byte) { return (rword(byte >> 2) >> ((byte & 3u) * 8u)) & 0xFFu; }
// Four bytes starting at any byte offset, little-endian. A Q6_K block is 210 bytes, so a block
// base is only 2-byte aligned; within it the ql/qh runs a word covers start 4-aligned relative
// to that base, so the unaligned case funnels two words. Never reads past the block's own
// bytes: every caller's run ends at or before byte 192 (the scales), so the second word stays in
// the same block.
uint rw(uint byte) {
    uint sh = (byte & 3u) * 8u;
    uint w0 = rword(byte >> 2);
    if (sh == 0u) { return w0; }
    return (w0 >> sh) | (rword((byte >> 2) + 1u) << (32u - sh));
}
uint ru16(uint byte) { return rb(byte) | (rb(byte + 1u) << 8u); }
float f16tof32(uint bits) { return unpackHalf2x16(bits & 0xffffu).x; }
int sgn8(uint b) { return int(b << 24u) >> 24; }

void main() {
#ifdef STREAMED
    w_addr = arena_base(pc.arena_lo, pc.arena_hi); // resident tensor base byte address; NO LUT/slot multiply
#endif
    uint nblk32 = pc.k / BLK;     // 32-element steps along k = activation 32-blocks
    uint kw = pc.k / 4u;
    uint tilesN = pc.n / BN;
#ifdef EXPERT_GRID
    uint ex = gl_WorkGroupID.y;
    uint cnt = counts[ex];
    if ((gl_WorkGroupID.x / tilesN) * BM >= cnt) { return; }
    uint wgRow = offsets[ex] + (gl_WorkGroupID.x / tilesN) * BM;
    uint rowEnd = offsets[ex] + cnt;
#ifdef PAGED
    // Resolved AFTER the count early-exit: a bucket with count 0 was never routed, so its LUT
    // entry may be stale/absent — no workgroup that would read it gets here.
    w_addr = arena_base(pc.arena_lo, pc.arena_hi)
             + uint64_t(lut[pc.w_base + ex]) * uint64_t(pc.slot_bytes);
    uint wbase = 0u;
#elif defined(STREAMED)
    // Expert base scaled onto the 64-bit pointer — pc.m is REPURPOSED as the per-expert BYTE
    // stride in this build (same convention as native_gemv_id.comp's STREAMED arm); pc.w_base
    // keeps its small within-bank element offset. Kills the u32 `ex * stride` element multiply.
    w_addr += uint64_t(ex) * uint64_t(pc.m);
    uint wbase = pc.w_base;
#else
    uint wbase = pc.w_base + ex * pc.m;
#endif
#else
    uint wgRow = (gl_WorkGroupID.x / tilesN) * BM;
    uint wbase = pc.w_base;
#endif
    uint wgCol = (gl_WorkGroupID.x % tilesN) * BN;
    uint li = gl_LocalInvocationIndex;
    uint tr = li / (BN / TN);
    uint tc = li % (BN / TN);

    float acc[TM][TN];
    [[unroll]] for (uint i = 0u; i < TM; i++)
        [[unroll]] for (uint j = 0u; j < TN; j++) acc[i][j] = 0.0;

#ifdef EXPERT_GRID
    // Dead-row mask for partial expert tiles — see native_gemm_mmq_q4k.comp's `live` doc (same
    // reasoning, same wave-coherent tr stripe; staging + both barriers stay unconditional).
    bool live = (wgRow + tr * TM) < rowEnd;
#else
    const bool live = true;
#endif

    for (uint blk32 = 0u; blk32 < nblk32; blk32++) {
        // stage activations: BM rows × WPB packed words (rows ≥ m read garbage, output ignored)
        for (uint idx = li; idx < BM * WPB; idx += THREADS) {
            uint r = idx / WPB;
            uint p = idx % WPB;
            As[r * SP + p] = qa[(wgRow + r) * kw + blk32 * WPB + p];
        }
        // per-col scales d·sc for the step's two 16-element sub-blocks
        for (uint idx = li; idx < 2u * BN; idx += THREADS) {
            uint cc = idx >> 1u;
            uint h = idx & 1u;
            uint gstart = wbase + (wgCol + cc) * pc.k + blk32 * BLK;
            uint bd = (gstart / 256u) * 210u;
            uint p0 = gstart % 256u; // a multiple of 32: the chunk never straddles a 128-half
            uint hf = p0 / 128u;
            uint og = (p0 % 128u) / 32u;
            float d = f16tof32(ru16(bd + 208u));
            uint sc_idx = hf * 8u + h + 2u * og;
            Bdl[idx] = d * float(sgn8(rb(bd + 192u + sc_idx)));
        }
        // stage weights: BN cols × WPB words, (q6 − 32) → packed signed int8
        for (uint idx = li; idx < BN * WPB; idx += THREADS) {
            uint cc = idx / WPB;
            uint wd = idx % WPB; // word wd → chunk elements 4*wd .. 4*wd+3
            uint gstart = wbase + (wgCol + cc) * pc.k + blk32 * BLK;
            uint bd = (gstart / 256u) * 210u;
            uint p0 = gstart % 256u;
            uint hf = p0 / 128u;
            uint og = (p0 % 128u) / 32u;
            // ggml Q6_K nibble map (see native_decode.glsl FMT_Q6K, the production GEMV decode):
            // og pairs {0,2} share ql[l] (low/high nibble), {1,3} share ql[l+32] — byte select on
            // og&1, nibble select on og<2; the 2 high bits sit at (qh[l] >> 2·og) & 3. A random
            // (non-64-periodic) bank is what catches a transposition here — nc_gemm_parity.rs and
            // moe_mmq_q6k_parity.rs use one.
            uint ql = rw(bd + hf * 64u + (og & 1u) * 32u + 4u * wd);
            uint qh = rw(bd + 128u + hf * 32u + 4u * wd);
            uint nib = (og < 2u) ? (ql & 0x0F0F0F0Fu) : ((ql >> 4u) & 0x0F0F0F0Fu);
            uint q = nib | (((qh >> (2u * og)) & 0x03030303u) << 4u);
            // q − 32 per byte with no cross-byte borrow: lift each byte to [128,191] first.
            Bs[cc * SP + wd] = ((q | 0x80808080u) - 0x20202020u) ^ 0x80808080u;
        }
        barrier();

        if (live) {
        int qsum[2][TM][TN];
        [[unroll]] for (uint h = 0u; h < 2u; h++)
            [[unroll]] for (uint i = 0u; i < TM; i++)
                [[unroll]] for (uint j = 0u; j < TN; j++) qsum[h][i][j] = 0;
        [[unroll]] for (uint p = 0u; p < WPB; p++) {
            int av[TM];
            int bv[TN];
            [[unroll]] for (uint i = 0u; i < TM; i++) av[i] = int(As[(tr * TM + i) * SP + p]);
            [[unroll]] for (uint j = 0u; j < TN; j++) bv[j] = int(Bs[(tc * TN + j) * SP + p]);
            [[unroll]] for (uint i = 0u; i < TM; i++)
                [[unroll]] for (uint j = 0u; j < TN; j++)
                    qsum[p / 4u][i][j] = dotPacked4x8AccSatEXT(av[i], bv[j], qsum[p / 4u][i][j]);
        }

        float dval[TM];
        [[unroll]] for (uint i = 0u; i < TM; i++)
            dval[i] = float(dact[(wgRow + tr * TM + i) * nblk32 + blk32]);
        // Sub-block 0 then sub-block 1 into each accumulator. The integer dp4a sums equal the old
        // 16-per-step loop's exactly, but the float accumulation is free to contract differently
        // (FMA), so outputs move at ulp level against it — measured up to 5.3e-5 on values near 22.
        [[unroll]] for (uint h = 0u; h < 2u; h++) {
            [[unroll]] for (uint j = 0u; j < TN; j++) {
                float dl = Bdl[2u * (tc * TN + j) + h];
                [[unroll]] for (uint i = 0u; i < TM; i++) {
                    acc[i][j] += dval[i] * dl * float(qsum[h][i][j]);
                }
            }
        }
        }
        // Placed AFTER the shared-scale reads above (Bdl/Bmm), not after the qsum loop: every
        // shared read of this iteration (As/Bs in qsum AND the per-col scales here) must complete
        // before any thread loops around and restages — a barrier between qsum and this block let
        // a fast thread overwrite Bdl/Bmm while a slow one was still reading them (data race,
        // exposed by the BN=128 wide tile's fuller occupancy; nondeterministic expert GEMM output).
        barrier();
    }

    [[unroll]] for (uint i = 0u; i < TM; i++) {
        uint rr = wgRow + tr * TM + i;
#ifdef EXPERT_GRID
        if (rr >= rowEnd) { continue; }
#endif
        [[unroll]] for (uint j = 0u; j < TN; j++) {
            c[rr * pc.n + (wgCol + tc * TN + j)] = acc[i][j];
        }
    }
}
