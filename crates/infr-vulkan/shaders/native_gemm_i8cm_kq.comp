#version 460
// int8 cooperative-matrix (WMMA) prefill GEMM for the K-quants (Q4_K, Q5_K, Q6_K):
// C[m,n] = A[m,k]·Wᵀ with A pre-quantized by `quant_q8` (int8 `qa`, per-32-block f16 scale
// `dact` and Σd·q `sact`) and W read raw by its 64-bit device address. A port of llama.cpp's
// `mul_mmq_cm1.comp` (the `matmul_q4_k_q8_1` family its Vulkan backend runs on RDNA3), with the
// roles transposed to infr's row-major output: the activation tile is the coopmat A operand
// (rows = tokens) and the weight tile is the B operand (columns = output features), so the 16
// lanes that share an accumulator row store 16 adjacent floats.
//
// Per 32-element k block the int32 dot of the int8 activations and the int8 weight values comes
// from `coopMatMulAdd`; each lane then scales its own accumulator elements into float sums:
//   Q4_K/Q5_K: w = d·sc·q − dmin·mn  →  Σ = dA·(d·sc)·Σqa·q + sA·(−dmin·mn)
//   Q6_K:      w = d·sc16·(q − 32), one scale per 16-element half → one int32 product per half.
// Reading accumulator elements directly relies on the fragment layout `coopmat_i8_layout.comp`
// verifies at init (`VulkanBackend::verify_i8_coopmat_layout`): lane `l` owns elements
// (2·e + (l >> 4), l & 15). Nothing dispatches this kernel unless that probe passed.
//
// Workgroup tile BT tokens × BW weight rows, each subgroup a 32×32 block of it (2×2 fragments),
// k staged BK_STEP blocks of 32 at a time through shared memory, the next step's global reads
// held in registers while the current step computes. Requires n % BW == 0, k % 256 == 0 (a
// K-quant superblock), w_base % 256 == 0 and k / 32 % BK_STEP == 0; rows past m read zeros and
// are never stored. requiredSubgroupSize = 32.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require

#include "native_weight_addr.glsl"

#if !defined(FMT_Q4K) && !defined(FMT_Q5K) && !defined(FMT_Q6K)
#error "native_gemm_i8cm_kq: define FMT_Q4K, FMT_Q5K or FMT_Q6K"
#endif
#if !defined(TILE_BT) || !defined(TILE_BW) || !defined(TILE_BKS)
#error "native_gemm_i8cm_kq: define TILE_BT, TILE_BW and TILE_BKS"
#endif

const uint BT = TILE_BT;       // tokens per workgroup
const uint BW = TILE_BW;       // weight rows (output features) per workgroup
const uint BK_STEP = TILE_BKS; // 32-element k blocks staged per barrier pair
const uint FRAG = 16u;
const uint SG_T = BT / 32u;
const uint NSG = SG_T * (BW / 32u);
const uint THREADS = NSG * 32u;

layout(local_size_x = THREADS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint m; uint n; uint k; uint w_base; uint w_lo; uint w_hi;
} pc;
layout(binding = 0) readonly buffer QA { uvec4 qa4[]; };       // [m, k] int8, 16 per uvec4
layout(binding = 1) readonly buffer DA { float16_t dact[]; };  // [m, k/32]
layout(binding = 2) readonly buffer SA { float16_t sact[]; };  // [m, k/32]
layout(binding = 3) writeonly buffer CB { float c[]; };        // [m, n]

#include "kq_stage.glsl"

void main() {
    w_addr = arena_base(pc.w_lo, pc.w_hi);
    uint tiles_t = (pc.m + BT - 1u) / BT;
    uint t0 = (gl_WorkGroupID.x % tiles_t) * BT;
    uint o0 = (gl_WorkGroupID.x / tiles_t) * BW;
    uint tid = gl_LocalInvocationIndex;
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint wt0 = (sg % SG_T) * 32u; // this subgroup's token offset in the tile
    uint ww0 = (sg / SG_T) * 32u; // and its weight-row offset
    uint col = lane & 15u;
    uint rhalf = lane >> 4u;

    float sums[2u * 2u * 8u];
    [[unroll]] for (uint i = 0u; i < 32u; i++) {
        sums[i] = 0.0;
    }

    uint nblk = pc.k / 32u;
    prefetch(t0, o0, 0u, tid);
    for (uint kb = 0u; kb < nblk; kb += BK_STEP) {
        store_to_shared(o0, kb, tid);
        barrier();
        if (kb + BK_STEP < nblk) {
            prefetch(t0, o0, kb + BK_STEP, tid);
        }
        [[unroll]] for (uint ks = 0u; ks < BK_STEP; ks++) {
            coopmat<int8_t, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseA> fa[4];
            coopmat<int8_t, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseB> fb[4];
            [[unroll]] for (uint r = 0u; r < 2u; r++) {
                [[unroll]] for (uint h = 0u; h < 2u; h++) {
                    coopMatLoad(fa[r * 2u + h], As, (wt0 + r * FRAG) * QP + ks * 8u + h * 4u, QP,
                                gl_CooperativeMatrixLayoutRowMajor);
                }
            }
            [[unroll]] for (uint cf = 0u; cf < 2u; cf++) {
                [[unroll]] for (uint h = 0u; h < 2u; h++) {
                    coopMatLoad(fb[cf * 2u + h], Bs, (ww0 + cf * FRAG) * QP + ks * 8u + h * 4u, QP,
                                gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
            float bd0[2];
            float bd1[2];
            [[unroll]] for (uint cf = 0u; cf < 2u; cf++) {
                uint wr = ww0 + cf * FRAG + col;
#ifdef FMT_Q6K
                bd0[cf] = Bd[(ks * KSCALES) * BW + wr];
                bd1[cf] = Bd[(ks * KSCALES + 1u) * BW + wr];
#else
                bd0[cf] = Bd[ks * BW + wr];
                bd1[cf] = Bmin[ks * BW + wr];
#endif
            }
            [[unroll]] for (uint r = 0u; r < 2u; r++) {
                float ad[8];
#ifndef FMT_Q6K
                float as_[8];
#endif
                [[unroll]] for (uint e = 0u; e < 8u; e++) {
                    uint tr = wt0 + r * FRAG + 2u * e + rhalf;
                    ad[e] = Ad[ks * BT + tr];
#ifndef FMT_Q6K
                    as_[e] = Asum[ks * BT + tr];
#endif
                }
                [[unroll]] for (uint cf = 0u; cf < 2u; cf++) {
                    uint s = (r * 2u + cf) * 8u;
#ifdef FMT_Q6K
                    coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator> acc0 =
                        coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator>(0);
                    coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator> acc1 =
                        coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator>(0);
                    acc0 = coopMatMulAdd(fa[r * 2u], fb[cf * 2u], acc0);
                    acc1 = coopMatMulAdd(fa[r * 2u + 1u], fb[cf * 2u + 1u], acc1);
                    [[unroll]] for (uint e = 0u; e < 8u; e++) {
                        float dot = fma(float(acc0[e]), bd0[cf], float(acc1[e]) * bd1[cf]);
                        sums[s + e] = fma(dot, ad[e], sums[s + e]);
                    }
#else
                    coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator> acc =
                        coopmat<int, gl_ScopeSubgroup, FRAG, FRAG, gl_MatrixUseAccumulator>(0);
                    acc = coopMatMulAdd(fa[r * 2u], fb[cf * 2u], acc);
                    acc = coopMatMulAdd(fa[r * 2u + 1u], fb[cf * 2u + 1u], acc);
                    [[unroll]] for (uint e = 0u; e < 8u; e++) {
                        float t = fma(float(acc[e]) * ad[e], bd0[cf], sums[s + e]);
                        sums[s + e] = fma(as_[e], bd1[cf], t);
                    }
#endif
                }
            }
        }
        barrier();
    }

    [[unroll]] for (uint r = 0u; r < 2u; r++) {
        [[unroll]] for (uint cf = 0u; cf < 2u; cf++) {
            uint s = (r * 2u + cf) * 8u;
            uint oc = o0 + ww0 + cf * FRAG + col;
            [[unroll]] for (uint e = 0u; e < 8u; e++) {
                uint tr = t0 + wt0 + r * FRAG + 2u * e + rhalf;
                if (tr < pc.m) {
                    c[tr * pc.n + oc] = sums[s + e];
                }
            }
        }
    }
}
